# Copy to `.env` and fill out before running docker compose

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/streetsense

# JWT Secret for authentication.
# Generate one with: openssl rand -base64 48
# Changing it signs every user out, which is what you want after a leak.
JWT_SECRET=change-me-generate-a-long-random-string

# Admin password for the moderation panel. Exchanged once for an 8h token.
ADMIN_PASSWORD=change-me-use-a-long-unique-password

# Google OAuth Client ID (Get from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Public host/domain exposed by the proxy (used by Caddy and CORS)
PUBLIC_HOST=your-domain-or-ip

# CORS Origin (comma-separated client URLs)
CORS_ORIGIN=https://your-domain-or-ip,https://www.your-domain-or-ip,http://your-domain-or-ip,http://www.your-domain-or-ip,http://localhost:3000,https://localhost:3000

# Public URL the backend uses for self references
BACKEND_PUBLIC_URL=https://your-domain-or-ip

# Frontend build-time variables (Vite reads VITE_* only)
VITE_BACKEND_URL=https://your-domain-or-ip
VITE_GOOGLE_CLIENT_ID=

# Rate Limiting (requests per 15 minutes)
RATE_LIMIT_MAX=100

# Node Environment
NODE_ENV=development

# Server Port
PORT=5000

# Telegram bot token for emergency-contact alerts (optional).
# Without it, SOS alerts are recorded but no messages are sent.
TELEGRAM_BOT_TOKEN=

# Crowd map privacy controls (optional).
# Positions are snapped to a grid and only published once this many people
# share a cell, so the map cannot be used to locate one person.
CROWD_GRID_DEGREES=0.0015
CROWD_MIN_CLUSTER=3
CROWD_MAX_BBOX_DEGREES=2

# Cloudflare R2 (Image Storage)
# Create a bucket at https://dash.cloudflare.com → R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=streetsense-images
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
