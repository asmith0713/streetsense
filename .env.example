# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/streetsense

# JWT Secret for authentication (use a long random string in production)
JWT_SECRET=your-secret-key-here-change-this

# Admin Password for moderation panel
ADMIN_PASSWORD=your-admin-password

# CORS Origin (client URL)
CORS_ORIGIN=http://localhost:3000

# Google OAuth Client ID (Get from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
