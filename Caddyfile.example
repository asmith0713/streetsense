# Sample Caddy configuration for StreetSense
# Replace example.com with your domain or IP before deploying.

http://example.com {
    redir https://example.com{uri} permanent
}

https://example.com {
    encode zstd gzip

    # The API is mounted under /api only. Sending /reports/* or /auth/* here
    # would break the client-side routes of the same name.
    @backend path /api/*
    reverse_proxy @backend backend:5000

    @health path /health
    reverse_proxy @health backend:5000

    reverse_proxy frontend:80
}
